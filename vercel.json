{
  "rewrites": [
    { "source": "/admin/orders", "destination": "/orders.html" },
    { "source": "/admin/orders/", "destination": "/orders.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
